# Absolute path to the local SQLite database file.
# The npm scripts (db:push / db:generate / db:migrate / db:reset) inline this
# value via `$(pwd)/db/custom.db`, so you only need to set it here if you run
# the Prisma CLI directly.
DATABASE_URL="file:/absolute/path/to/apps/78-ai-recipe-meal-planner/db/custom.db"

# Optional — when the heuristic planner can't satisfy a constraint set, the
# swap endpoint can fall back to an LLM-suggested alternative. Leave unset to
# use the deterministic MockProvider (no network calls).
# ZAI_API_KEY=""
# ZAI_API_SECRET=""
